PORT=8000
NODE_ENV=development

# Database Configuration (PostgreSQL 16 with btree_gist)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=servicehub
# Local direct connection (outside docker):
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/servicehub?schema=public"
# Docker Compose internal connection (inside container):
# DATABASE_URL="postgresql://postgres:postgrespassword@postgres:5432/servicehub?schema=public"

# Redis Configuration (BullMQ & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Minimum 32 characters in production)
JWT_SECRET=your-secure-jwt-access-secret-key-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-secure-jwt-refresh-secret-key-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

# CORS & Client Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# Observability & API Documentation
SWAGGER_ENABLED=false
LOG_FORMAT=json

